# MySQL connection (use PlanetScale / Railway / Aiven free tier for Vercel deployments)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=chinthaka_cv
DB_SSL=false

# Session / auth
JWT_SECRET=replace_with_a_long_random_string
# Used only once to bootstrap the admins table on first `npm run db:init`.
# After that, change the password from the back office (/admin/password) instead of editing this.
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword',10))"
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

NODE_ENV=development
PORT=3000

RECAPTCHA_SITE_KEY=...
RECAPTCHA_SECRET_KEY=...

NTFY_URL=...
NTFY_TOPIC=...
NTFY_TOKEN=...

CRON_SECRET=...