<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <div class="admin-shell">
    <%- include('partials/sidebar') %>
    <main class="admin-main">
      <div class="admin-header">
        <h1><%= pageTitle %></h1>
      </div>

      <% if (error) { %><div class="alert"><%= error %></div><% } %>
      <% if (success) { %><div class="alert" style="background: rgba(80, 250, 123, 0.12); color: var(--green);"><%= success %></div><% } %>

      <form class="admin-form" method="POST" action="/admin/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <label for="currentPassword">Current Password *</label>
        <input type="password" id="currentPassword" name="currentPassword" required />

        <label for="newPassword">New Password *</label>
        <input type="password" id="newPassword" name="newPassword" minlength="8" required />

        <label for="confirmPassword">Confirm New Password *</label>
        <input type="password" id="confirmPassword" name="confirmPassword" minlength="8" required />

        <div style="margin-top:24px;">
          <button type="submit" class="btn">Update Password</button>
        </div>
      </form>
    </main>
  </div>
</body>
</html>
