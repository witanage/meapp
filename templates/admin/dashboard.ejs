<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
  <div class="admin-shell">
    <%- include('partials/sidebar') %>
    <main class="admin-main">
      <div class="admin-header">
        <h1><%= pageTitle %></h1>
      </div>
      <div class="dashboard-grid">
        <% Object.keys(counts).forEach(function (key) { %>
          <div class="dashboard-card">
            <a href="/admin/<%= key %>" style="text-decoration:none;color:inherit;display:block;">
              <div class="count"><%= counts[key].count %></div>
              <div><%= counts[key].title %></div>
            </a>
            <form method="POST" action="/admin/visibility/<%= key %>" style="margin-top:10px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn secondary"><%= counts[key].visible ? 'Visible - hide' : 'Hidden - show' %></button>
            </form>
          </div>
        <% }); %>
      </div>
    </main>
  </div>
</body>
</html>
