<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <div class="admin-shell">
    <%- include('partials/sidebar') %>
    <main class="admin-main">
      <div class="admin-header">
        <h1><%= pageTitle %></h1>
      </div>

      <% if (error) { %><div class="alert"><%= error %></div><% } %>

      <form class="admin-form" method="POST" action="/admin/profile">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <label for="name">Full Name *</label>
        <input type="text" id="name" name="name" value="<%= profile.name || '' %>" required />

        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= profile.title || '' %>" />

        <label for="objective">Career Objective</label>
        <textarea id="objective" name="objective"><%= profile.objective || '' %></textarea>

        <label for="phone">Phone</label>
        <input type="text" id="phone" name="phone" value="<%= profile.phone || '' %>" />

        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= profile.email || '' %>" />

        <label for="location">Location</label>
        <input type="text" id="location" name="location" value="<%= profile.location || '' %>" />

        <label for="linkedin">LinkedIn</label>
        <input type="text" id="linkedin" name="linkedin" value="<%= profile.linkedin || '' %>" />

        <div style="margin-top:24px;">
          <button type="submit" class="btn">Save Changes</button>
        </div>
      </form>
    </main>
  </div>
</body>
</html>
