<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
  <div class="login-shell">
    <main class="login-main">
      <div class="login-card">
        <h1>Two-factor verification</h1>
        <% if (qr) { %>
          <p>Scan this QR code with Authy, Microsoft Authenticator or any TOTP app, then enter the 6-digit code.</p>
          <img src="<%= qr %>" alt="Authenticator QR code" width="200" height="200" />
          <p>Or enter this key manually: <code><%= secret %></code></p>
        <% } else { %>
          <p>Enter the 6-digit code from your authenticator app.</p>
        <% } %>
        <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
        <form method="POST" action="/admin/login/verify" class="login-form">
          <div class="field">
            <label for="code">Authentication code</label>
            <input type="text" id="code" name="code" inputmode="numeric" pattern="[0-9 ]*" maxlength="7" autocomplete="one-time-code" required autofocus />
          </div>
          <button type="submit" class="btn login-submit">Verify</button>
        </form>
        <a class="login-back" href="/admin/login">&larr; Back to login</a>
      </div>
    </main>
  </div>
</body>
</html>
